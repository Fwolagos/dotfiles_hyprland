{
    "layer": "top",
    "position": "top",
    "height": 33,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["custom/distro","hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
		"wireplumber#source-muted",
        "network",
		"wireplumber",
        "bluetooth",
        "memory",
        "cpu",
        "temperature",
        "gpu",
        "battery",
		"hyprland/language"
    ],
	"wireplumber#source-muted": {
		"node-type": "Audio/Source",
		"format": "󰍬",
		"format-muted": "󰍭",
		"tooltip": true
	},

    "hyprland/workspaces": {
		"format": "{icon}",
		"show-special":true,
		"format-icons":{
			"special":"󰮯",
			"special:magic":"󰮯",
			"magic":"󰮯"
		}
    },

	"custom/distro": {
    "format": " ",
    "tooltip": false
	},
	

    "clock": {
        "format": "󰀠\u2002{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network": {
	    "interface": "wlan0",
		"format-wifi": "{icon}",
		"format-ethernet": "󰈀",
		"format-disconnected": "󰤮",
		"format-icons": [
			"󰤯",
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨"
		],
		"tooltip-format-wifi": "{essid} ({signalStrength}%)"
    },

    "bluetooth": {
        "format": "\u2002{status}",
        "format-disabled": "󰂲\u2002Off",
        "format-connected": "󰂱\u2002{num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}"
    },

    "cpu": {
        "format": "\u2002{usage}%",
        "interval": 2
    },

    "gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "󰢮\u2002{}%",
        "interval": 2
    },

    "memory": {
        "format": "\u2002{percentage}%",
        "interval": 2
    },

    "temperature": {
		 "thermal-zone": 2,
		 "hwmon-path": ["/sys/class/hwmon/hwmon2/temp1_input", "/sys/class/thermal/thermal_zone0/temp"],
		 "critical-threshold": 80,
		"format-critical": "\u2002{temperatureC}°",// the temperature is in celcius
        "format": "\u2002{temperatureC}°",
		"interval":  2
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}\u2002{capacity}",
        "format-icons": ["", "", "", "", ""]
    },

	"hyprland/language":{
		"format": "{short}"

	},
	"wireplumber":{
	"format": "{icon}\u2002{volume}%",
	"format-muted": "",
	"format-icons": ["", "", ""]
	}
}
